{
    "name": "tree-linker",
    "displayName": "Tree Linker",
    "version": "1.1.0",
    "packageManager": "pnpm@10.32.1",
    "browserslist": "Chrome >= 96",
    "description": "Vertical Tabs Sidebar, But In Tree Structure",
    "author": "Garin",
    "license": "AGPL-3.0",
    "homepage": "https://linkmap.cc",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com:SeanPedersen/TreeLinker.git"
    },
    "bugs": {
        "url": "https://github.com/SeanPedersen/TreeLinker/issues"
    },
    "engines": {
        "node": "^20.11.0 || ^22.0.0"
    },
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "start": "vite",
        "start:edge": "TARGET=edge vite",
        "build": "vite build",
        "build-edge": "TARGET=edge vite build",
        "build:analyze": "ANALYZE=true vite build",
        "test": "pnpm build",
        "lint": "pnpm lint:es && pnpm lint:style",
        "lint:es": "eslint -c .eslintrc.js --ext .ts,.tsx ./src/**/*.tsx ./src/**/*.ts",
        "lint:style": "stylelint --config .stylelintrc.json src/**/*.{css,less,scss}",
        "clean": "rimraf -rf ./extension ./*.zip ./*.crx",
        "reinstall": "rimraf -rf ./node_modules && pnpm",
        "prepare": "husky install",
        "test-ext": "jest --config ./jest.config.js",
        "package": "./build-target.sh"
    },
    "lint-staged": {
        "*.{ts,tsx,js}": [
            "eslint -c .eslintrc.js",
            "format-imports --config .vscode/import-sorter.json"
        ],
        "*.{css,less,scss}": [
            "stylelint --config .stylelintrc.json"
        ],
        "*.{ts,tsx,json,js,css,less,scss,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "antd": "5.0.1",
        "dayjs": "1.11.6",
        "dexie": "3.2.3",
        "firebase": "9.17.1",
        "firebaseui": "6.0.2",
        "jquery": "3.6.3",
        "jquery-contextmenu": "2.9.2",
        "jquery.fancytree": "2.38.2",
        "lodash": "4.17.21",
        "loglevel": "1.8.1",
        "mousetrap": "1.6.5",
        "mustache": "4.2.0",
        "normalize.css": "8.0.1",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-router-dom": "6.4.3",
        "webextension-polyfill": "0.10.0"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.4.0",
        "@garinz/webext-bridge": "5.0.6",
        "@reduxjs/toolkit": "1.9.2",
        "@types/chrome": "0.0.203",
        "@types/jest": "29.2.5",
        "@types/jquery": "3.5.14",
        "@types/jquery.contextmenu": "1.7.35",
        "@types/jqueryui": "1.12.16",
        "@types/lodash": "4.14.190",
        "@types/mousetrap": "1.6.11",
        "@types/mustache": "4.2.2",
        "@types/node": "18.11.9",
        "@types/react": "18.0.25",
        "@types/react-dom": "18.0.9",
        "@types/react-router-dom": "5.3.3",
        "@types/sinon-chrome": "2.2.11",
        "@types/webextension-polyfill": "0.9.1",
        "@types/wicg-file-system-access": "2020.9.5",
        "@vitejs/plugin-react": "^6.0.1",
        "@yutengjing/eslint-config-react": "0.0.8",
        "@yutengjing/prettier-config": "0.0.1",
        "ansi-colors": "4.1.3",
        "eslint": "8.28.0",
        "format-imports": "3.1.3",
        "husky": "8.0.2",
        "identity-obj-proxy": "3.0.0",
        "jest": "29.3.1",
        "jest-environment-jsdom": "29.3.1",
        "less": "4.1.3",
        "lint-staged": "13.0.4",
        "postcss-less": "6.0.0",
        "postcss-scss": "4.0.5",
        "prettier": "2.8.0",
        "react-redux": "8.0.5",
        "rimraf": "3.0.2",
        "sass": "1.98.0",
        "sinon-chrome": "3.0.1",
        "stylelint": "14.15.0",
        "stylelint-config-prettier": "9.0.4",
        "stylelint-config-recess-order": "3.0.0",
        "stylelint-config-standard": "29.0.0",
        "stylelint-declaration-block-no-ignored-properties": "2.6.0",
        "stylelint-scss": "4.3.0",
        "ts-jest": "^29.1.0",
        "type-fest": "0.20.2",
        "typescript": "^5.4.0",
        "vite": "^8.0.0"
    }
}
